# 复制为 .env.production 后使用。不要提交真实值，也不要把它放进前端代码。
SULLYOS_DOMAIN=api.example.com
SULLYOS_TLS_EMAIL=you@example.com
SULLYOS_IMAGE_TAG=production

POSTGRES_DB=sullyos
POSTGRES_USER=sullyos
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD

# 浏览器请求会携带这把令牌。只通过 HTTPS 使用，并填入 SullyOS 后端设置页。
APP_TOKEN=REPLACE_WITH_RANDOM_APP_TOKEN

# 必须只列出实际前端 Origin，逗号分隔，不要使用 *。
# 初次用本机 Vite 测试时可保留 127.0.0.1/localhost；正式前端域名另行加入。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://app.example.com

# 如果要恢复现有本地数据库，这个值必须与本地加密模型池时使用的密钥一致：
# 本地 MODEL_VAULT_KEY 非空就复制它；若本地留空，则复制旧 APP_TOKEN 到这里。
MODEL_VAULT_KEY=REPLACE_WITH_RANDOM_MODEL_VAULT_KEY

# 可留空，之后继续在 SullyOS 设置页维护模型池。不要把 /chat/completions 写进 URL。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TEMPERATURE=0.85
MODEL_MAX_TOKENS=8000
MODEL_TIMEOUT_MS=300000
MODEL_FAILURE_COOLDOWN_MS=300000

# Worker 默认不会启动。开启 heartbeat profile 后才读取这些配置。
HEARTBEAT_POLL_MS=30000
HEARTBEAT_DEMO_MODE=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
