# 普通聊天模型（OpenAI-compatible /chat/completions）
# 把 SullyOS 里已经测试成功的 URL、Key、模型名复制到这里；不要把 .env 上传到 Git。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TEMPERATURE=0.85
MODEL_MAX_TOKENS=8000
MODEL_TIMEOUT_MS=300000
# 可选；用于加密设置页新增的模型密钥。留空时使用 APP_TOKEN 派生。
MODEL_VAULT_KEY=
MODEL_FAILURE_COOLDOWN_MS=300000

# Worker 每 30 秒检查一次；检查不等于每次调用 AI。
HEARTBEAT_POLL_MS=30000
HEARTBEAT_DEMO_MODE=false
